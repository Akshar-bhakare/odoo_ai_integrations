ODOO_URL=https://your-company.odoo.com
ODOO_API_KEY=replace-with-server-only-api-key
ODOO_DATABASE=replace-with-database-name
SESSION_SECRET=replace-with-at-least-32-random-characters

# Voice stock transcription. Keep this server-side; never use NEXT_PUBLIC_*.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Low-cost structured-output model used to ground natural-language inventory requests.
OPENAI_QUERY_MODEL=gpt-4o-mini

# Local Phase 5.5 diagnostics only. Never expose these through NEXT_PUBLIC_* variables.
ODOO_TEST_LOGIN=rt@sunlectric.in
ODOO_TEST_PASSWORD=000000
INCENTIVE_DEBUG_BASE_URL=http://localhost:3000
INCENTIVE_DEBUG_MONTH=
INCENTIVE_DEBUG_EMPLOYEE_ID=
INCENTIVE_DEBUG_VALID_WRITE=false
